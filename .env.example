# Cấu hình chung của project. File .env thật dùng cho secret/token và local override.
PROJECT_NAME=airbnb-analytics-platform
ENVIRONMENT=development

# MotherDuck
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=airbnb_analytics
MOTHERDUCK_SCHEMA=bronze

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=airbnb-data
MINIO_SECURE=false

# OpenAI / LLM
GROQ_API_KEY=
LLM_MODEL=

# Streamlit
STREAMLIT_SERVER_PORT=8501

# Airflow
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./airflow
