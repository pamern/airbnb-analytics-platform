# Cau hinh chung cua project. File .env that dung cho secret/token va local override.
PROJECT_NAME=airbnb-analytics-platform
ENVIRONMENT=development

# dbt local PostgreSQL
DBT_TARGET=local
DBT_TARGET_SCHEMA=public

# PostgreSQL local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airbnb_analytics
POSTGRES_USER=airbnb
POSTGRES_PASSWORD=airbnb

# pgAdmin local
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=admin

# MotherDuck production
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=airbnb_analytics
MOTHERDUCK_SCHEMA=bronze

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=airbnb-data
MINIO_SECURE=false

# OpenAI / LLM
GROQ_API_KEY=
LLM_MODEL=

# Streamlit
STREAMLIT_SERVER_PORT=8501

# Airflow
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./airflow
