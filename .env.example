# Cấu hình chung của project. File .env thật dùng cho secret/token và local override.
PROJECT_NAME=airbnb-analytics-platform
ENVIRONMENT=development

# MotherDuck
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=airbnb_analytics
MOTHERDUCK_SCHEMA=bronze

# OpenAI / LLM
GROQ_API_KEY=
LLM_MODEL=

# Streamlit
STREAMLIT_SERVER_PORT=8501

# S3-compatible Object Storage (for example, Cloudflare R2)
OBJECT_STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET_NAME=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_PREFIX=airbnb-models
